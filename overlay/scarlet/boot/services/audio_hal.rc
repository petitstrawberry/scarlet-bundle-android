service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service
    class hal
    disabled
    user audioserver
    # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct wakelock context_hub
    chdir /
    setenv LD_LIBRARY_PATH /vendor/lib64/hw:/vendor/lib64:/system/lib64
    setenv LD_PRELOAD /vendor/lib64/libscarlet-audiobinder.so:/vendor/lib64/hw/android.hardware.audio@7.1-impl.ranchu.so:/vendor/lib64/hw/android.hardware.audio.legacy@7.1-impl.ranchu.so:/vendor/lib64/hw/android.hardware.audio.effect@7.0-impl.so
